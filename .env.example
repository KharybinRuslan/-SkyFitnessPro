# Базовый URL fitness API. Все запросы (курсы, «Мои курсы», прогресс) идут на этот хост.
# Не задавай переменную — используется готовый бэкенд https://wedev-api.sky.pro/api/fitness (локальный бэк не нужен).
# Свой бэкенд: задай полный путь, например http://localhost:3000/api/fitness
VITE_API_URL=

# Пути авторизации относительно VITE_API_URL (или полный URL).
# По умолчанию: /auth/login и /auth/register.
# Если бэкенд использует /login и /register — задайте:
# VITE_API_AUTH_LOGIN=/login
# VITE_API_AUTH_REGISTER=/register
# VITE_API_AUTH_LOGIN=
# VITE_API_AUTH_REGISTER=
